# Copy to .env next to docker-compose.yml. `.env` is ignored by git.

# Shared password every employee types once per device. Required for a hosted
# installation; leave the variable unset only on a private site LAN.
BASSIGNANA_ACCESS_PASSWORD=change-this-to-a-long-shared-password

# Port published on the host machine (the container always listens on 8080).
BASSIGNANA_PUBLISHED_PORT=8080

# Set to 1 once the site is reached over HTTPS (reverse proxy, tunnel or a
# hosting platform), so the session cookie is only ever sent encrypted.
BASSIGNANA_HTTPS=0

# WAL is right for a local disk. Use DELETE if /data is on a network share.
BASSIGNANA_SQLITE_JOURNAL_MODE=WAL

# Worker threads of the Waitress server.
BASSIGNANA_THREADS=8
